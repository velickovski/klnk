{
  "name": "personal-voice-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx apps/server/src/main.ts",
    "worker": "tsx apps/server/src/worker-main.ts",
    "mobile": "npm run start --workspace @personal-agent/mobile",
    "mobile:web": "npm run web --workspace @personal-agent/mobile",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @personal-agent/mobile",
    "demo": "tsx scripts/demo.ts",
    "db:migrate": "tsx apps/server/src/migrate.ts",
    "setup:check": "tsx scripts/readiness.ts",
    "setup:providers": "tsx scripts/readiness.ts --providers",
    "setup:iphone": "tsx scripts/iphone-setup.ts",
    "demo:voice": "tsx scripts/voice-demo.ts",
    "e2e:build": "tsx scripts/e2e-build.ts",
    "e2e": "playwright test",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:pg": "tsx scripts/test-postgres.ts",
    "test:components": "jest --config apps/mobile/component-test/jest.config.cjs",
    "build:server": "tsx scripts/build-server.ts",
    "start:server": "node dist/server/src/main.js",
    "start:worker": "node dist/server/src/worker-main.js",
    "db:migrate:compiled": "node dist/server/src/migrate.js",
    "test:compiled": "tsx scripts/compiled-smoke.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@fastify/cors": "11.3.1",
    "@fastify/rate-limit": "11.2.1",
    "dotenv": "^17.2.3",
    "fastify": "5.12.7",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "ws": "^8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.2",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@expo/cli": {
      "zod": "4.6.7"
    }
  }
}
