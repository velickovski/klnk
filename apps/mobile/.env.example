# Public build/runtime metadata only. NEVER put ElevenLabs/Twilio keys here.
# Use an actual owned bundle identifier and Expo project before building.
IOS_BUNDLE_IDENTIFIER=
EXPO_OWNER=
EAS_PROJECT_ID=
# Optional default; the iPhone connection screen can select the backend without rebuilding.
EXPO_PUBLIC_API_URL=http://localhost:4000
# Local development only; EAS development profile also configures native local networking.
IOS_ALLOW_LOCAL_NETWORK=true
EXPO_PUBLIC_ALLOW_LOCAL_HTTP=true
