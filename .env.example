# Local mode runs PostgreSQL in-process using PGlite, with durable .data storage.
PORT=4000
HOST=127.0.0.1
NODE_ENV=development
CALL_PROVIDER=simulator
EMBEDDED_WORKER=true
DEMO_ENABLED=true
LEGACY_ENABLED=false
# Explicit trusted reverse-proxy IP/CIDR ranges only; never use true.
TRUST_PROXY=false
# A separate operator-only bearer token for detailed /ready output. Never expose in Expo.
OPERATOR_TOKEN=
# Optional real browser conversation: npm run demo:voice, then http://localhost:4100/demo.
# Server-only key with GPT-Live access. Never use EXPO_PUBLIC_ for this key.
# The demo uses gpt-live-1 / marin and a tool-free gpt-6.1-sol backend.
# A user click starts paid OpenAI usage. Local demo sessions request closure after five minutes.
# This does not enable external telephone calls or any mission execution.
OPENAI_API_KEY=
# Set DATABASE_URL to use a PostgreSQL server (required for multiple processes).
# DATABASE_URL=postgresql://agent:password@localhost:5432/agent
# Production: independently generate 32 random bytes encoded in hex; never commit.
# DATA_ENCRYPTION_KEY=
APP_ORIGINS=http://localhost:8081,http://localhost:8082
EXPO_PUBLIC_API_URL=http://localhost:4000
# Live calling is separately gated; do not enable until a real test is approved.
LIVE_CALLS_ENABLED=false
LIVE_OWNER_ID=
LIVE_TEST_RECIPIENTS=
# Public HTTPS origin for backend and /webhooks/elevenlabs; no tunnel/deployment is started automatically.
PUBLIC_API_URL=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Separate private, tool-free owner conversation agent (optional for the exact-message demo parser).
ELEVENLABS_OWNER_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Must be an assistant voice accessible to the configured ElevenLabs account.
ELEVENLABS_STANDARD_VOICE_ID=
# Required before live calls: identify the actual provider and exact configured retention.
ELEVENLABS_LLM_PROVIDER=
PROVIDER_RETENTION_VERIFIED=false
PROVIDER_RETENTION_DISCLOSURE=
# Optional server calendar. Access tokens belong to one owner integration, never mobile.
# Google OAuth client credentials and redirect setup are documented in docs/PROVIDERS.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/integrations/google-calendar/callback
